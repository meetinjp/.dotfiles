// niri — Wayland scrollable-tiling compositor.
// TUXEDO InfinityBook Pro 14 (AMD Gen10): single AMD iGPU (Radeon 890M).
// niri auto-selects the only DRM device — no render-device pinning needed.
//
// Shell: Noctalia (Quickshell). Provides bar + launcher + notifications +
// lock + polkit + wallpaper + idle handling. Spawned via `qs -c noctalia-shell`.
// Launcher / lock / volume / brightness / media keys all use noctalia IPC.
//
// Live-reloads on save. Validate with: niri validate
// Action reference:                    niri msg action
// Cheat sheet inside the session:      Mod + Shift + /

// ─── INPUT ───────────────────────────────────────────────────────────────────

input {
	mod-key "Alt"

    keyboard {
        xkb {
            layout "pl"
            // Caps Lock → Ctrl is handled OS-level by keyd, not here.
        }
        repeat-delay 400
        repeat-rate 30
    }

    touchpad {
        tap                              // tap-to-click (1/2/3-finger tap = L/R/M)
        dwt                              // disable while typing
        natural-scroll                   // macOS-style: two-finger up = content moves up
        accel-speed 0.2
        accel-profile "adaptive"
        // button-areas: bottom-left physical press = L click,
        //   bottom-right physical press = R click (Windows-style).
        // Tap-to-click still gives you 2-finger-tap = R click as a bonus.
        click-method "button-areas"
    }

    mouse {
        accel-speed 0.0
        accel-profile "flat"
    }

    warp-mouse-to-focus
    // focus-follows-mouse deliberately off — keyboard-driven focus only.
}

// ─── OUTPUT ──────────────────────────────────────────────────────────────────
// Laptop panel only. kanshi handles dynamic dock profiles (laptop / laptop+external)
// over Niri IPC when an external connects.

// PER-HOST: output name (eDP-1 / eDP-2 / etc.), resolution, refresh, and
// scale depend on the laptop panel. Confirm via `niri msg outputs` and
// adjust below if needed. scale 1.75 = larger text + UI on the 2880x1800
// panel; bump higher for chunkier, drop to 1.0 for native pixel-perfect.
output "eDP-1" {
    mode "2880x1800@120.000"
    scale 1.75
    transform "normal"
    position x=0 y=0
    variable-refresh-rate on-demand=true
}

// ─── LAYOUT ──────────────────────────────────────────────────────────────────

layout {
    gaps 0
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    // No focus ring, no border, no shadow — completely chromeless windows.
    focus-ring { off; }
    border { off; }
    shadow { off; }

    struts {
        left 0
        right 0
        top 0
        bottom 0
    }

    background-color "#1d2021"
}

prefer-no-csd

// ─── CURSOR ──────────────────────────────────────────────────────────────────

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
    hide-when-typing
}

// ─── HOTKEY OVERLAY ──────────────────────────────────────────────────────────

hotkey-overlay {
    skip-at-startup
}

// ─── ENVIRONMENT ─────────────────────────────────────────────────────────────
// Only what Niri itself launches.

environment {
    // DISPLAY intentionally unset here — xwayland-satellite picks the
    // socket and exports DISPLAY itself when it comes up.
    QT_QPA_PLATFORM "wayland;xcb"
    QT_QPA_PLATFORMTHEME "qt5ct"
    GDK_BACKEND "wayland,x11"
    MOZ_ENABLE_WAYLAND "1"
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    XCURSOR_SIZE "24"
    XCURSOR_THEME "Adwaita"
    NIXOS_OZONE_WL "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}

// ─── DEBUG ───────────────────────────────────────────────────────────────────

debug {
    // Required for Noctalia: lets quickshell notifications + window
    // activation requests succeed even when the xdg-activation serial
    // is stale.
    honor-xdg-activation-with-invalid-serial
}

// ─── SCREENSHOT ──────────────────────────────────────────────────────────────

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// ─── ANIMATIONS ──────────────────────────────────────────────────────────────

// Stock niri animations (defaults). Previously customized — slowdown 0.7 (1.4x
// faster) + workspace-switch { off; } to hide a brief Noctalia-bar flash when
// switching between workspaces that both have a fullscreen window. Reverted to
// defaults on request. If that bar-flash on fullscreen workspace switches
// bothers you, re-add an `animations { workspace-switch { off; } }` block here.

// ─── WINDOW RULES ────────────────────────────────────────────────────────────

window-rule {
    match title="^Picture-in-Picture$"
    open-floating true
    default-column-width { fixed 480; }
}

// ── Ghostty ──
// at-startup ws1 spawn → fullscreen. Every later manual Mod+Q → maximized.
// Two separate rules keyed on at-startup so they never collide.
window-rule {
    match app-id="com\\.mitchellh\\.ghostty" at-startup=true
    match app-id="^ghostty$" at-startup=true
    open-on-workspace "1"
    open-fullscreen true
}
window-rule {
    match app-id="com\\.mitchellh\\.ghostty" at-startup=false
    match app-id="^ghostty$" at-startup=false
    open-maximized true
}

// ── Zen Browser ──
// clip-to-geometry strips the CSD corner halos; at-startup → ws2 fullscreen.
window-rule {
    match app-id="^zen$"
    clip-to-geometry true
}
window-rule {
    match app-id="^zen$" at-startup=true
    open-on-workspace "2"
    open-fullscreen true
}

// ─── SWITCH EVENTS ───────────────────────────────────────────────────────────

switch-events {
    lid-close {
        spawn "qs" "-c" "noctalia-shell" "ipc" "call" "lockScreen" "lock"
    }
}

// Workspaces are dynamic per-monitor stacks (niri default). No persistent
// declarations — `Mod+N` targets the Nth ws of the currently focused
// monitor. Moving a workspace between monitors renumbers it into the
// destination's stack. The at-startup window-rules below still place
// ghostty + zen on ws1 + ws2 because niri auto-creates them on the
// focused monitor at spawn time.

// ─── SPAWN AT STARTUP ────────────────────────────────────────────────────────
// Noctalia covers bar + launcher + notifications + lock + polkit + wallpaper.
// xwayland-satellite handles X11 apps. kanshi manages multi-monitor.
// wlsunset warms the display color temperature after sunset.
// Ghostty + Zen auto-launch and land in their workspaces (rules below).

// Push Wayland env into the systemd user manager + dbus activation env so
// xdg-desktop-portal-gnome (screencast for Loom/OBS/Meet) sees WAYLAND_DISPLAY
// and starts cleanly. niri is not launched as niri.service here, so we start
// niri-session-anchor.service (stowed to ~/.config/systemd/user/) to pull up
// graphical-session.target — user services that bind to it then come up.
spawn-at-startup "sh" "-c" "systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP; dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP; systemctl --user start niri-session-anchor.service; systemctl --user restart xdg-desktop-portal.service xdg-desktop-portal-gnome.service"

spawn-at-startup "qs" "-c" "noctalia-shell"
spawn-at-startup "kanshi"
spawn-at-startup "xwayland-satellite"
// wlsunset — gamma/temp shift by real sunrise/sunset. Replace the lat/long
// below with your coordinates (e.g. -l 52.23 -L 21.01 for Warsaw); decimal
// degrees, north + / south -, east + / west -. Defaults: 6500K day, 4000K night.
spawn-at-startup "wlsunset" "-l" "52.23" "-L" "21.01"

// Apps gated behind $NIRI_SKIP_APPS — unset = launch (default), set to
// anything = skip. Useful for a clean debug session: `NIRI_SKIP_APPS=1 niri`.
// Form `[ -n $var ] || cmd` returns 0 cleanly when skip is set AND
// propagates cmd's exit code when skip is unset (so real spawn failures
// still surface in niri's log).
spawn-sh-at-startup "[ -n \"$NIRI_SKIP_APPS\" ] || ghostty"
spawn-sh-at-startup "[ -n \"$NIRI_SKIP_APPS\" ] || zen-browser"

// ─── KEYBINDINGS ─────────────────────────────────────────────────────────────
// Mod = Alt (set via mod-key above; niri's default is Super).
// Lock is Mod+Escape; Mod+L is focus-column-right so lock can't sit there.
// Noctalia actions go through `qs -c noctalia-shell ipc call <module> <verb>`.

binds {
    Mod+Shift+Slash      { show-hotkey-overlay; }

    // Launchers
    Mod+Q                hotkey-overlay-title="Terminal"        { spawn "ghostty"; }
    Mod+E                hotkey-overlay-title="File manager"    { spawn "ghostty" "-e" "yazi"; }
    Mod+Space            hotkey-overlay-title="App launcher"    { spawn-sh "qs -c noctalia-shell ipc call launcher toggle"; }
    Mod+Shift+Q          hotkey-overlay-title="Session menu"    { spawn-sh "qs -c noctalia-shell ipc call sessionMenu toggle"; }
    Mod+Escape           allow-when-locked=true                 { spawn-sh "qs -c noctalia-shell ipc call lockScreen lock"; }

    // Session — quit only via Ctrl+Alt+Delete (no easy mis-hit combo).
    Mod+C                { close-window; }
    Ctrl+Alt+Delete      { quit; }
    Mod+Shift+P          { power-off-monitors; }

    // Focus — vim-style (h/l = column, j/k = window in column).
    Mod+H                { focus-column-left; }
    Mod+L                { focus-column-right; }
    Mod+J                { focus-window-down; }
    Mod+K                { focus-window-up; }
    Mod+Left             { focus-column-left; }
    Mod+Right            { focus-column-right; }
    Mod+Down             { focus-window-down; }
    Mod+Up               { focus-window-up; }
    Mod+Home             { focus-column-first; }
    Mod+End              { focus-column-last; }

    // Move within workspace
    Mod+Ctrl+H           { move-column-left; }
    Mod+Ctrl+L           { move-column-right; }
    Mod+Ctrl+J           { move-window-down; }
    Mod+Ctrl+K           { move-window-up; }
    Mod+Ctrl+Home        { move-column-to-first; }
    Mod+Ctrl+End         { move-column-to-last; }

    // Workspaces — integer N targets the Nth ws of the focused monitor.
    // Stack is dynamic per-monitor; no Hyprland-style global identity.
    Mod+1                { focus-workspace 1; }
    Mod+2                { focus-workspace 2; }
    Mod+3                { focus-workspace 3; }
    Mod+4                { focus-workspace 4; }
    Mod+5                { focus-workspace 5; }
    Mod+6                { focus-workspace 6; }
    Mod+7                { focus-workspace 7; }
    Mod+8                { focus-workspace 8; }
    Mod+9                { focus-workspace 9; }
    Mod+Shift+1          { move-column-to-workspace 1; }
    Mod+Shift+2          { move-column-to-workspace 2; }
    Mod+Shift+3          { move-column-to-workspace 3; }
    Mod+Shift+4          { move-column-to-workspace 4; }
    Mod+Shift+5          { move-column-to-workspace 5; }
    Mod+Shift+6          { move-column-to-workspace 6; }
    Mod+Shift+7          { move-column-to-workspace 7; }
    Mod+Shift+8          { move-column-to-workspace 8; }
    Mod+Shift+9          { move-column-to-workspace 9; }

    Mod+U                { focus-workspace-down; }
    Mod+I                { focus-workspace-up; }
    Mod+Page_Down        { focus-workspace-down; }
    Mod+Page_Up          { focus-workspace-up; }
    Mod+Ctrl+Page_Down   { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up     { move-column-to-workspace-up; }

    Mod+WheelScrollDown  cooldown-ms=100 { focus-workspace-down; }
    Mod+WheelScrollUp    cooldown-ms=100 { focus-workspace-up; }

    // Multi-monitor (laptop + external)
    // Focus monitor:  Mod + Shift + hjkl
    // Move workspace: Mod + Shift + arrow         (entire ws + its columns)
    // Move column:    Mod + Shift + Ctrl + hjkl/arrow
    Mod+Shift+H            { focus-monitor-left; }
    Mod+Shift+L            { focus-monitor-right; }
    Mod+Shift+J            { focus-monitor-down; }
    Mod+Shift+K            { focus-monitor-up; }
    Mod+Shift+Left         { move-workspace-to-monitor-left; }
    Mod+Shift+Right        { move-workspace-to-monitor-right; }
    Mod+Shift+Up           { move-workspace-to-monitor-up; }
    Mod+Shift+Down         { move-workspace-to-monitor-down; }
    Mod+Shift+Ctrl+H       { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+L       { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+J       { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K       { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Left    { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right   { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Up      { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Down    { move-column-to-monitor-down; }

    // Consume / expel — niri's signature column manipulation.
    Mod+Comma            { consume-window-into-column; }
    Mod+Period           { expel-window-from-column; }
    Mod+BracketLeft      { consume-or-expel-window-left; }
    Mod+BracketRight     { consume-or-expel-window-right; }

    // Column / window sizing
    Mod+R                { switch-preset-column-width; }
    Mod+Shift+R          { switch-preset-window-height; }
    Mod+Minus            { set-column-width "-10%"; }
    Mod+Equal            { set-column-width "+10%"; }
    Mod+Ctrl+Minus       { set-window-height "-10%"; }
    Mod+Ctrl+Equal       { set-window-height "+10%"; }

    // Maximize / fullscreen / center
    Mod+F                { maximize-column; }
    Mod+Shift+F          { fullscreen-window; }
    Mod+Ctrl+F           { expand-column-to-available-width; }
    Mod+Ctrl+C           { center-column; }

    // Layout modes
    Mod+W                { toggle-column-tabbed-display; }
    Mod+V                { toggle-window-floating; }
    Mod+Shift+V          { switch-focus-between-floating-and-tiling; }
    Mod+O                { toggle-overview; }

    // Scratchpad on workspace 10.
    Mod+S                { focus-workspace 10; }
    Mod+Shift+S          { move-column-to-workspace 10; }

    // Multimedia — routed through Noctalia IPC so OSD appears.
    XF86AudioRaiseVolume  allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call volume increase"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call volume decrease"; }
    XF86AudioMute         allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call volume muteOutput"; }
    XF86AudioMicMute      allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call volume muteInput"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call brightness increase"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call brightness decrease"; }
    XF86AudioNext         allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call media next"; }
    XF86AudioPrev         allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call media previous"; }
    XF86AudioPlay         allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call media playPause"; }
    XF86AudioPause        allow-when-locked=true { spawn-sh "qs -c noctalia-shell ipc call media playPause"; }

    // Screenshots — niri's built-in interactive UI.
    Print                { screenshot; }
    Ctrl+Print           { screenshot-screen; }
    Mod+Print            { screenshot-window; }
}
