#!/usr/bin/env bash
set -euo pipefail
# Keep sync state outside the disposable cache. Initialization is deliberately
# separate: this command never retries a failed bisync with --resync.

sync_dir="$HOME/work/ai/OneDrive"
remote_dir="onedrive:LinuxSync"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/rclone/bisync"

usage() {
	cat <<USAGE
Usage: onedrive-sync [--dry-run]

Sync $sync_dir with $remote_dir using rclone bisync.
Changes and deletions propagate in both directions. Keep a separate backup.

  --dry-run, -n  Preview changes without copying or deleting files.
  --help, -h     Show this help.

Before the first run, follow ~/.dotfiles/scripts/onedrive/README.md
to authenticate, create access markers, and initialize bisync manually.
USAGE
}

extra_args=()
if [[ $# -gt 1 ]]; then
	usage >&2
	exit 2
fi
case "${1:-}" in
	'') ;;
	--dry-run|-n) extra_args=(--dry-run) ;;
	--help|-h) usage; exit 0 ;;
	*) usage >&2; exit 2 ;;
esac

if ! command -v rclone >/dev/null 2>&1; then
	echo 'onedrive-sync: rclone is missing from PATH; see ~/.dotfiles/scripts/onedrive/README.md.' >&2
	exit 1
fi
if [[ ! -d "$sync_dir" || ! -f "$sync_dir/RCLONE_TEST" ]]; then
	echo "onedrive-sync: $sync_dir or its RCLONE_TEST access marker is missing." >&2
	echo "Follow the initialization steps in ~/.dotfiles/scripts/onedrive/README.md." >&2
	exit 1
fi

umask 077
mkdir -p "$state_dir"
exec rclone bisync "$sync_dir" "$remote_dir" \
	--workdir "$state_dir" --check-access --create-empty-src-dirs --verbose "${extra_args[@]}"
