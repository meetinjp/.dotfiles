#!/usr/bin/env sh
# Run a process on the Nvidia dGPU via PRIME render offload.
# AMD iGPU stays the desktop renderer; Nvidia wakes only for this child.
#
# Usage:
#   prime-run firefox
#   prime-run blender
#   prime-run glxinfo | grep "OpenGL renderer"

exec env \
    __NV_PRIME_RENDER_OFFLOAD=1 \
    __NV_PRIME_RENDER_OFFLOAD_PROVIDER=NVIDIA-G0 \
    __GLX_VENDOR_LIBRARY_NAME=nvidia \
    __VK_LAYER_NV_optimus=NVIDIA_only \
    "$@"
