// zellij — terminal multiplexer driven by lunar/cavecrew layouts. Keep
// the defaults except for the few opinions below; reference:
// https://zellij.dev/documentation/options

// Match wezterm's GruvboxLightHard. Run `zellij setup --check` after
// editing to confirm the theme name still resolves.
theme "gruvbox-light"

// Default shell — lunar spawns zellij from wezterm, so respect $SHELL.
default_shell "zsh"

// Don't print Zellij's startup tip every session.
show_startup_tips false
show_release_notes false

// Pane frames eat a row of screen real estate per pane; the status bar
// already shows what frames would show.
pane_frames false

// Copy-on-select keeps yanked text in the system clipboard so wezterm's
// own copy-paste keybinds still work.
copy_on_select true
copy_command "wl-copy"   // override per host if not on Wayland
