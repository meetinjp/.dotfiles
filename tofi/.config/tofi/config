# tofi launcher — themed to match waybar (dark bg, #268bd2 accent).
# Anything not set here keeps the upstream default. Reference: man 5 tofi.

font = "Sans"
font-size = 16
hint-font = false

# Window
anchor = top
width = 100%
height = 30
background-color = #1d1f21
outline-width = 0
border-width = 0
padding-top = 0
padding-bottom = 0
padding-left = 5
padding-right = 5

# Layout
horizontal = true
num-results = 9
min-input-width = 240
# 2 * 10px waybar padding
result-spacing = 20

# Text
placeholder-color = #FFFFFFA8
selection-color = #268bd2
selection-background = #444
selection-match-color = #00000000

# Prompt
prompt-text = "Enter Input > "
placeholder-text = "input"
