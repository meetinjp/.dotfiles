# kanshi — auto-switch monitor profiles based on which outputs are connected.
# Reference: man 5 kanshi
# Niri exposes outputs over its IPC; kanshi talks to it directly.
#
# To add a monitor, get its name from `niri msg outputs` (HDMI-A-1, DP-1, or a
# "Make Model Serial" description) and write a new profile for the set of
# outputs that will be connected together.

# Laptop alone.
profile laptop {
    output eDP-1 mode 2880x1800@120 position 0,0 scale 1.75 adaptive_sync off
}

# Laptop + 1 external. Laptop on left, external (Dell SE2426HG) on right.
#
# These values MUST stay identical to the output blocks in
# niri/.config/niri/config.kdl; see the OUTPUT section there for why.
#
# The @240 is mandatory: the panel's EDID-preferred mode is 60 Hz, so an
# unqualified `mode 1920x1080` silently drops it to 60.
#
# adaptive_sync off matches niri, which configures no VRR at all.
profile docked {
    output eDP-1 mode 2880x1800@120 position 0,0 scale 1.75 adaptive_sync off
    output HDMI-A-1 mode 1920x1080@240 position 1646,0 scale 1 adaptive_sync off
}
