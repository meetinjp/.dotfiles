# Claude Code per-directory local state (auto-generated, machine-specific).
# Leading slash anchors to the repo root, so a future `claude/` package
# with a nested `claude/.claude/` is unaffected.
/.claude/

# Editor swap/backup files
*.swp
*.swo
*.bak
*~

# OS junk
.DS_Store
Thumbs.db

# Per-host overrides (sourced by zshrc; kept out of repo on purpose)
*.local
.zshrc.local
.envrc.local
.envrc

# Rendered git configs (built by setup.sh from git/*.template)
# — they contain identity, so they must never land in the public repo.
git/.gitconfig
git/.gitconfig-work
