# Claude Code per-directory local state (auto-generated, machine-specific).
# Leading slash anchors to the repo root, so a future `claude/` package
# with a nested `claude/.claude/` is unaffected.
/.claude/

# Editor swap/backup files
*.swp
*.swo
*.bak
*~

# OS junk
.DS_Store
Thumbs.db

# Per-host overrides (sourced by zshrc; kept out of repo on purpose).
# No wildcard — bin/.local/ is a legit stow path mirroring ~/.local/bin.
.zshrc.local
.envrc.local
.envrc

# Ghostty per-host override (the `?config.local` optional include). The macOS
# override (config-macos.conf) IS tracked; this host-local one is not.
ghostty/.config/ghostty/config.local

# Python checks must not add generated bytecode to configuration packages.
__pycache__/
*.pyc
