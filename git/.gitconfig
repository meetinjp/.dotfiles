[user]
	name = meetinjp
	email = meetinjp@proton.me
	# signingkey is set by setup.sh after GPG key generation.

[commit]
	gpgsign = true

[tag]
	gpgSign = true

# Repos cloned under ~/work/lunar/ auto-switch to the work email.
# Everything outside that tree is assumed personal.
# Case-insensitive so ~/Work/Lunar/foo works on Windows/macOS too.
[includeIf "gitdir/i:~/work/lunar/"]
	path = ~/.gitconfig-work
